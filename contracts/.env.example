# Copy to .env and fill in. NEVER commit the real .env.

# Private key of the deployer wallet (0x-prefixed). Use a dedicated/throwaway
# wallet for deploys, funded with just enough gas ETH.
PRIVATE_KEY=

# Robinhood Chain RPC endpoints (public ones are rate-limited).
RPC_URL=https://rpc.mainnet.chain.robinhood.com
RPC_URL_TESTNET=https://rpc.testnet.chain.robinhood.com
